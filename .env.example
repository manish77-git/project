# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored. NEVER commit real passwords or secrets.

# Required by the access-code endpoints (POST /api/bills/access/*) and by
# `npm run access:issue`. At least 32 characters. Without a usable value those
# endpoints answer 503 instead of issuing weakly-protected codes.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ACCESS_SECRET=

# Optional. Where issued code digests are written and read when no database is
# configured. Default: data/access-codes.json (git-ignored).
# ACCESS_CODES_FILE=data/access-codes.json

# Optional. When set, access codes live in the access_codes table (bcrypt
# hashes, durable lockout) and that table is the attempt authority. When unset,
# the seed file plus an in-memory throttle is used instead.
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/navigator

# Optional. Enables the public POST /api/bills/explain endpoint (Stage 4).
# Without a key the endpoint answers 503 explanation_unavailable; it never
# returns an unvalidated draft. The key is sent only in a server-side header
# and is never included in prompts, responses or logs.
GEMINI_API_KEY=

# Optional. Gemini text model used by the provider adapter.
# Default: gemini-3.5-flash-lite
# The model receives only field keys and whether each value exists; it never
# receives an amount, date, bill number, hospital name or access token.
GEMINI_MODEL=
